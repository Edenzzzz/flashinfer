  int32_t dyn_len_kv_chunk;        // KV chunk size limit for this task
  int32_t dyn_uniform_num_m_blocks; // >0 if all seqs have same num_m_blocks (fast O(1) lookup)
  IdType* dyn_scalars;             // [4] GPU buffer: {num_seqs, total_tiles, len_kv_chunk, uniform_num_m_blocks}
                                   // When non-null (CUDA graph mode), kernel reads from this instead of frozen scalars

